FROM maven:3.9.12-eclipse-temurin-17 AS builder

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -pl data-agent-management -am package -DskipTests -Dspotless.apply.skip=true \
    && cp data-agent-management/target/spring-ai-alibaba-data-agent-management-*.jar /workspace/app.jar

FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/config /app/uploads /app/vectorstore

COPY --from=builder /workspace/app.jar /app/app.jar

EXPOSE 8065

ENTRYPOINT ["java", "-jar", "/app/app.jar", "--spring.config.location=classpath:application.yml,optional:file:/app/config/application.yml"]
