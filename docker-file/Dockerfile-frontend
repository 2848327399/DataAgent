FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable

COPY data-agent-frontend-nuxt/package.json data-agent-frontend-nuxt/pnpm-lock.yaml data-agent-frontend-nuxt/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY data-agent-frontend-nuxt/ .
RUN pnpm generate

FROM nginx:1.27-alpine

COPY docker-file/config/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/.output/public /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
