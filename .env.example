# Copy this file to .env before deploying. Never commit the real .env file.
MYSQL_DATABASE=saa_data_agent
MYSQL_USER=dataagent
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Public HTTP listener. Use 127.0.0.1 when a host-level HTTPS reverse proxy is used.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=80
IMAGE_TAG=latest
TZ=Asia/Shanghai

# Python sandbox settings. Pin DATAAGENT_SANDBOX_IMAGE to a digest in production.
DATAAGENT_SANDBOX_IMAGE=agentscope-registry.ap-southeast-1.cr.aliyuncs.com/agentscope/runtime-sandbox-base:latest
DATAAGENT_PYPI_INDEX_URL=https://pypi.org/simple

# Optional Langfuse observability.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
